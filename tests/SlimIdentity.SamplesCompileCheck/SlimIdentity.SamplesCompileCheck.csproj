<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Compile check for the copy-paste templates in samples/templates (they are not shipped).
    Part of the solution, so every build and CI run keeps them in sync with the library API.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\samples\templates\**\*.cs" Exclude="..\..\samples\templates\**\bin\**;..\..\samples\templates\**\obj\**" />
    <ProjectReference Include="..\..\src\SlimIdentity\SlimIdentity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="SendGrid" />
    <PackageReference Include="System.DirectoryServices.Protocols" />
  </ItemGroup>
</Project>
