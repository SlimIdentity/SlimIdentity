<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SlimIdentity.EntityFrameworkCore</RootNamespace>
    <!-- EF Core itself is not Native-AOT compatible (model building uses reflection) -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <!-- NuGet package (shared metadata: src/Directory.Build.props) -->
  <PropertyGroup>
    <PackageId>SlimIdentity.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core stores for SlimIdentity: implement one interface on your own user entity, add one line to OnModelCreating and one to the service registration – users, 2FA, refresh tokens, server-side sessions and external logins are persisted in your DbContext. Atomic where it matters, verified against SQLite, PostgreSQL and SQL Server.</Description>
    <PackageTags>aspnetcore;authentication;slimidentity;entityframeworkcore;efcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\SlimIdentity\SlimIdentity.csproj" />
    <!-- small, no third-party dependencies; the passkey store is only registered with o.Passkeys = true -->
    <ProjectReference Include="..\SlimIdentity.Passkeys\SlimIdentity.Passkeys.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
