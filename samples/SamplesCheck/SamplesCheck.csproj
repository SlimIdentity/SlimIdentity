<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Compile check for the copy-paste templates in samples/ (they are not shipped).
    Part of the solution, so every build and CI run keeps them in sync with the library API.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\**\*.cs" Exclude="..\SamplesCheck\**;..\SlimIdentity.Demo\**;..\**\bin\**;..\**\obj\**" />
    <ProjectReference Include="..\..\src\SlimIdentity\SlimIdentity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="SendGrid" />
    <PackageReference Include="System.DirectoryServices.Protocols" />
  </ItemGroup>
</Project>
