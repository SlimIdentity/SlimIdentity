{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SlimIdentity": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "AllowedHosts": []
  },
  "SlimIdentity": {
    "TrustedOrigins": [ "https://localhost:5173" ],
    "Links": {
      "BaseUrl": "https://localhost:5173"
    },
    "RateLimit": {
      "PermitLimit": 20
    },
    "Tokens": {
      "Issuer": "SlimIdentityDemo",
      "Audience": "SlimIdentityDemoClient"
    },
    "TwoFactor": {
      "AuthenticatorIssuer": "SlimIdentity Demo"
    },
    "ExternalLogin": {
      "TrustedEmailProviders": [ "Google" ]
    }
  }
}
