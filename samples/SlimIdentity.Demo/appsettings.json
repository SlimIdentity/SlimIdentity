{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SlimIdentity": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "AllowedHosts": []
  },
  "SlimIdentity": {
    "RoutePrefix": "/auth",
    "Endpoints": {
      "EnableRegistration": true,
      "DefaultUseCookies": false
    },
    "SignIn": {
      "RequireConfirmedEmail": false
    },
    "RateLimit": {
      "PermitLimit": 20,
      "Window": "00:01:00"
    },
    "Tokens": {
      "Issuer": "SlimIdentityDemo",
      "Audience": "SlimIdentityDemoClient",
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "7.00:00:00"
    },
    "Cookies": {
      "CookieName": "SlimAuth",
      "SameSite": "Strict"
    },
    "TwoFactor": {
      "AuthenticatorIssuer": "SlimIdentity Demo"
    },
    "ExternalLogin": {
      "TrustedEmailProviders": [ "Google" ],
      "AllowedReturnUrls": [ "https://localhost:5173" ]
    },
    "Csrf": {
      "AllowedOrigins": [ "https://localhost:5173" ]
    }
  }
}
