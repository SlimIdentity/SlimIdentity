# Normalize line endings in the repository, check out with the platform default.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.slnx    text
*.json    text
*.md      text diff=markdown
*.yml     text
*.ts      text
*.sql     text
*.http    text
*.sh      text eol=lf

*.png     binary
*.snk     binary
